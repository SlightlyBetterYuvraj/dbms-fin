# Application Environment
APP_ENV=development
PORT=3000

# Authoritative Database (Supabase / PostgreSQL)
# Placeholders only - do not commit real secrets
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVER_ONLY
DATABASE_URL=postgresql://postgres:REPLACE_ME@YOUR-PROJECT.supabase.co:5432/postgres

# Scheduling Generator Service (Optional Hosted Adapter)
# Leave empty to trigger local fallback workflow
GENERATOR_SERVICE_URL=
GENERATOR_SERVICE_TOKEN=REPLACE_ME

# JWT / Session Secrets
SESSION_SECRET=REPLACE_ME_WITH_A_SECURE_RANDOM_STRING
